{
  "triggers": {
    "single_clap": "opening_amathuba",
    "double_clap": "claude_task",
    "triple_clap": "screenshot",
    "short_whistle": "play_pause",
    "long_whistle": "maximize_window",
    "gesture_point": "open_claude",
    "gesture_peace": "open_calendar",
    "gesture_three": "opening_amathuba",
    "gesture_rock": "play_pause",
    "gesture_palm": "claude_task"
  },
  "claude": {
    "claude_path": "~/.local/bin/claude.exe",
    "default_dir": "~",
    "notes_file": "~/Documents/jarvis-notes.md",
    "autobuilder_inbox": "~/Downloads/autobuilder/inbox"
  },
  "face_check_enabled": true,
  "cooldown_seconds": 2,
  "jarvis_responses": {
    "armed": "Systems online. Awaiting your command.",
    "disarmed": "Jarvis standing by.",
    "face_not_found": "Unauthorized user detected. Ignoring command.",
    "sleep_laptop": "Initiating sleep mode.",
    "open_amathuba": "Opening Amathuba."
  }
}
